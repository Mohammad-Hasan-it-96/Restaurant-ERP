APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=app
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Telegram alert sink (error+critical). Implement App\Logging\TelegramHandler
# before flipping LOG_TELEGRAM_ENABLED=true, then run `php artisan config:cache`.
LOG_TELEGRAM_ENABLED=false
LOG_TELEGRAM_LEVEL=error
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_erp_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=restaurant_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Automatic backups (spatie/laravel-backup) ──
# Password encrypts the zip (DB dump + images + .env). Leave empty = no encryption.
BACKUP_ARCHIVE_PASSWORD=
# Destination disk for backups (local now; add 's3' in config/backup.php for off-host).
BACKUP_DESTINATION_DISK=local
# Set to the MySQL bin directory if mysqldump is not on PATH (e.g. C:/xampp/mysql/bin).
DB_DUMP_BINARY_PATH=

# ── Activity log (business audit trail) ──
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_RETENTION_DAYS=365

# ── Health check thresholds ──
HEALTH_DISK_WARN_PERCENT=90
HEALTH_FAILED_JOBS_WARN=25

# ── Telegram alert tuning (dedup window / rate limit) ──
ALERT_DEDUP_TTL=300
ALERT_RATE_MAX=10
ALERT_RATE_WINDOW=300

VITE_APP_NAME="${APP_NAME}"
APP_TIMEZONE=Asia/Damascus
