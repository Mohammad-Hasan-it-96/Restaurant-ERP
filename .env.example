APP_NAME="Restaurant ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=app
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Telegram alert sink (error+critical). Implement App\Logging\TelegramHandler
# before flipping LOG_TELEGRAM_ENABLED=true, then run `php artisan config:cache`.
LOG_TELEGRAM_ENABLED=false
LOG_TELEGRAM_LEVEL=error
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_db
DB_USERNAME=root
DB_PASSWORD=
# MySQL session timezone (offset). Leave at UTC and let APP_TIMEZONE drive display.
DB_TIMEZONE=+00:00

# Admin account for `php artisan db:seed` (manual/dev seeding only — the installer
# wizard creates the admin from operator input instead). If ADMIN_PASSWORD is unset
# the seeder generates a random one and prints it. In production the seeder REFUSES
# to create an admin unless ALLOW_PROD_SEED=true (guards against a stray db:seed
# planting a known-password backdoor across the fleet).
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ALLOW_PROD_SEED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=restaurant_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Automatic backups (spatie/laravel-backup) ──
# AES-256 password for the backup zip (DB dump + images + .env). The install wizard
# auto-generates a strong per-install value; only set it by hand for a manual (non-
# wizard) deploy. Once backups exist, do NOT change it — older archives become
# undecryptable. Empty = NO encryption (unsafe: the zip embeds every secret).
BACKUP_ARCHIVE_PASSWORD=
# Destination disk(s), comma-separated. Off-host shipping needs no source edit:
# set to `local,s3` and fill AWS_* below to also push backups off the box.
BACKUP_DESTINATION_DISK=local
# Optional email for spatie/laravel-backup mail notifications (mail is disabled by
# default — backup health is surfaced through LogService/Telegram instead). Leave
# commented; an empty value fails spatie's email validation.
# BACKUP_NOTIFICATION_EMAIL=ops@yourdomain.com
# Set to the MySQL bin directory if mysqldump is not on PATH (e.g. C:/xampp/mysql/bin).
DB_DUMP_BINARY_PATH=

# ── Activity log (business audit trail) ──
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_RETENTION_DAYS=365

# ── Health check thresholds ──
HEALTH_DISK_WARN_PERCENT=90
HEALTH_FAILED_JOBS_WARN=25

# ── Telegram alert tuning (dedup window / rate limit) ──
ALERT_DEDUP_TTL=300
ALERT_RATE_MAX=10
ALERT_RATE_WINDOW=300

# ── Order business rules (config/orders.php) ──
ORDER_NUMBER_PREFIX=ORD-
ORDER_DUPLICATE_GUARD_SECONDS=5

# ── API tuning (config/api.php) — throttles are "maxAttempts,decayMinutes" ──
API_THROTTLE_DEFAULT=60,1
API_THROTTLE_LOGS=30,1
API_THROTTLE_GUEST=10,1
API_THROTTLE_ORDERS=20,1
API_MAX_PER_PAGE=100
API_PRODUCT_LIST_TTL=300
API_HTTP_CACHE_MAX_AGE=300

# ── Dashboard cache TTLs in seconds (config/dashboard.php) ──
DASHBOARD_STATS_TTL=120
DASHBOARD_DETAILED_STATS_TTL=300
DASHBOARD_STATUS_COUNTS_TTL=300

# ── Uploaded image compression (config/images.php) ──
IMAGE_MAX_WIDTH=1200
IMAGE_QUALITY=75
IMAGE_PNG_COMPRESSION=6

# ── Backup schedule times HH:MM (config/backup.php) ──
BACKUP_CLEAN_AT=01:30
BACKUP_RUN_AT=02:00

# Note: per-list pagination sizes live in config/pagination.php (config-only).

VITE_APP_NAME="${APP_NAME}"
APP_TIMEZONE=UTC

# ── Brand theme (config/theme.php) ──
# Single source of truth for brand colours, consumed by the admin panel and the
# customer SPA. The installer writes THEME_PRIMARY; run `php artisan config:cache`
# in production after changing these. Defaults preserve the current look.
THEME_PRIMARY="#C0392B"
THEME_PRIMARY_DARK="#922B21"
THEME_PRIMARY_LIGHT="#FDECEA"
